{
    "name": "xoops/vision2026",
    "description": "XOOPS 2026 Vision 2026 Reference Module - Modern PHP Architecture Showcase",
    "type": "xoops-module",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "XOOPS Team",
            "homepage": "https://xoops.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Vision2026\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vision2026\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src/ --level=8",
        "cs-fix": "php-cs-fixer fix src/"
    },
    "config": {
        "sort-packages": true
    }
}
